{
  "name": "bootcamp-treinos-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": [
      {
        "name": "pnpm",
        "version": "^11.0.0-rc.2",
        "onFail": "download"
      },
      {
        "name": "npm"
      }
    ]
  },
  "type": "module",
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage",
    "dev": "tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "audit:prod": "pnpm audit --prod",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "test": "prisma generate && tsc -p tsconfig.test.json && vitest run",
    "test:coverage": "prisma generate && tsc -p tsconfig.test.json && vitest run --coverage",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "test:watch": "prisma generate && vitest"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "^17.5.0",
    "prettier": "3.8.1",
    "prisma": "7.4.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@prisma/adapter-pg": "7.4.0",
    "@prisma/client": "7.4.0",
    "@scalar/fastify-api-reference": "1.76.0",
    "better-auth": "1.7.14",
    "dotenv": "17.3.1",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "6.1.0",
    "zod": "4.6.7"
  }
}
