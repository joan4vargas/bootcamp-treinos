# Servidor
PORT=3000

# Banco de dados — deve corresponder ao docker-compose.yml
DATABASE_URL="postgresql://postgres:password@localhost:5433/bootcamp-treinos-api"

# Gere um valor com (mínimo de 32 caracteres):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="troque-por-um-secret-aleatorio-com-32-caracteres"

# URL base usada pelo better-auth
BETTER_AUTH_URL=http://localhost:3000

# Origens permitidas para CORS e better-auth, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# Opcional: origens confiadas pelo better-auth diferentes do CORS
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Limites de requisições por IP
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW="1 minute"
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW="1 minute"

# Habilite apenas atrás de um proxy confiável
TRUST_PROXY=false

# Docker Compose de produção (opcional)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=bootcamp-treinos-api
