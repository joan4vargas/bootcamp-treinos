# Servidor
PORT=3000

# Banco de dados — deve corresponder ao docker-compose.yml
DATABASE_URL="postgresql://postgres:password@localhost:5433/bootcamp-treinos-api"

# Gere um valor com (mínimo de 32 caracteres):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="troque-por-um-secret-aleatorio-com-32-caracteres"

# URL base usada pelo better-auth
BETTER_AUTH_URL=http://localhost:3000
